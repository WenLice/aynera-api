    <ProjectReference Include="..\Aynera.Persistence\Aynera.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="AWSSDK.Rekognition" Version="3.7.502.58" />
