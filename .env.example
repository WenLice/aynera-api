ELARIS_DB_CONNECTION=Host=localhost;Port=5432;Database=elaris;Username=elaris;Password=elaris
ELARIS_REDIS=localhost:6379
ELARIS_JWT_ISSUER=elaris-api
ELARIS_JWT_SIGNING_KEY=dev-only-elaris-jwt-signing-key-change-in-prod-32chars
ELARIS_JWT_AUDIENCE_MEMBER_MOBILE=member-mobile
ELARIS_JWT_AUDIENCE_MEMBER_WEB=member-web
ELARIS_JWT_AUDIENCE_STAFF=staff
ELARIS_EMAIL_VERIFY_LINK_BASE_URL=http://localhost:5173/verify-email
# Email: Console (default) or Smtp
ELARIS_EMAIL_PROVIDER=Console
# ELARIS_SMTP_HOST=smtp.example.com
# ELARIS_SMTP_PORT=587
# ELARIS_SMTP_USE_SSL=true
# ELARIS_SMTP_USERNAME=
# ELARIS_SMTP_PASSWORD=
# ELARIS_SMTP_FROM=noreply@example.com
# ELARIS_SMTP_FROM_NAME=ElAris
# SMS: Console (default) or Textbelt (free key "textbelt" ≈ 1 SMS/day)
ELARIS_SMS_PROVIDER=Console
