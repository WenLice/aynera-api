AYNERA_DB_CONNECTION=Host=localhost;Port=5432;Database=aynera;Username=aynera;Password=Admin@1
AYNERA_REDIS=localhost:6379
AYNERA_JWT_ISSUER=aynera-api
AYNERA_JWT_SIGNING_KEY=dev-only-aynera-jwt-signing-key-change-in-prod-32chars
AYNERA_JWT_AUDIENCE_MEMBER=member
AYNERA_JWT_AUDIENCE_ADMIN=admin
AYNERA_EMAIL_VERIFY_LINK_BASE_URL=http://localhost:5173/verify-email
# ASP.NET nested configuration for deployed web origins (add more with index 1, 2, etc.)
# Aynera__Cors__Origins__0=https://www.aynera.in
# Email: Console (default) or Smtp
AYNERA_EMAIL_PROVIDER=Console
# AYNERA_SMTP_HOST=smtp.example.com
# AYNERA_SMTP_PORT=587
# AYNERA_SMTP_USE_SSL=true
# AYNERA_SMTP_USERNAME=
# AYNERA_SMTP_PASSWORD=
# AYNERA_SMTP_FROM=noreply@example.com
# AYNERA_SMTP_FROM_NAME=Aynera
# SMS: Console (default) or Textbelt (free key "textbelt" ≈ 1 SMS/day)
AYNERA_SMS_PROVIDER=Console
# AYNERA_TEXTBELT_API_KEY=textbelt
# First admin (created once on startup if no admin exists). Password is never logged.
# AYNERA_ADMIN_EMAIL=ops@example.com
# AYNERA_ADMIN_PHONE=9876543210
# AYNERA_ADMIN_PASSWORD=
